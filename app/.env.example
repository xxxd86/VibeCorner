# 复制成 app/.env 后填写。app/.env 已在 .gitignore 里，不会被提交。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 端口：本地默认 8848；云平台会注入 PORT
PORT=8848

# 0.0.0.0 = 本机 + 局域网都能访问；只想本机访问改成 127.0.0.1
HOST=0.0.0.0

# 家庭分享
# SHARE_TTL_HOURS=24
# SHARE_LAN_ONLY=0   # 部署到公网时必须设为 0，否则分享页只允许内网地址
